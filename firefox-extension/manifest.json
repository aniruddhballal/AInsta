{
  "manifest_version": 2,
  "name": "deadgram dashboard collector",
  "version": "3.0.0",
  "description": "Collects Instagram profile, post, and reel information only for jobs started in the local deadgram dashboard.",
  "permissions": [
    "tabs",
    "http://127.0.0.1:4317/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://www.instagram.com/*", "*://instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
